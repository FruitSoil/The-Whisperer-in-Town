quest_after = Array[String](["res://resources/Quests/Worker/ODNM1.tres"])
text_greetings = "Теперь же я предлагаю перейти к цели вашей миссии. Вам нужно будет реализовать план Г.Р.А.Д., написанный Джеймсом Б. 

Если кратко, то главная его цель - это уничтожить старые [b]\"военные технологии\"[/b], которые остались после [b]Мировой войны[/b] и ныне покоятся среди труднодоступных гор в [b]Уральском архипелаге[/b]. 
Простым способом ликвидировать останки у нас не получилось, так что было принято решение выстроить  неподалёку город с налаженным производством, чтобы там, на месте, соорудить всё  необходимое. 

Это вам и нужно будет сделать. Время от времени в помощь мы будем направлять к вам специалистов. 
На этом всё, удачной работы.


"
answer_agree = "(Продолжить)"
answer_wait = "Подождите"
answer_reject = "Сбросить трубку"
text_reject = "*Вы слышите гудки на той стороне, после чего звук исчезает*"
