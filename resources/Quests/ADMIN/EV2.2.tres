quest_name = "Препятствование взору"
text_greetings = "Нам поступила информация, что вы самолично [shake rate=20.0 level=5 connected=1][b]отказали Кэтерин Коллар[/b][/shake] в проведении проверки. 
Я могу понять ваши опасения, но поверьте мне на слово, не стоит мешать ей. Она из тех людей, на которых даже мы повлиять не можем. Впредь будьте осторожнее, если вам дорога ваша жизнь."
