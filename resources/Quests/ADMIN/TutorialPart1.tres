character_name = "Администрация"
quest_after = Array[String](["res://resources/Quests/ADMIN/TutorialPart2.tres"])
text_greetings = "Добро пожаловать на ваше новое рабочее место. Хочу подчеркнуть, что это очень важная и требовательная должность. Ранее она принадлежала Джеймсу Беккету, образцовому  чиновнику! После его скоропостижной смерти были назначены вы. Работайте усердно и оправдайте возложенный на вас долг.

Насколько мне известно, до этого вы не работали с системой Г.Р.А.Д.  В связи с вам проведёт краткую \"экскурсию\" электронный помощник JX10988.  Позже я вновь свяжусь с вами.

"
answer_agree = "Продолжить"
answer_wait = "Подождите"
answer_reject = "Сбросить трубку"
text_reject = "*Вы слышите гудки на той стороне, после чего звук исчезает*"
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
