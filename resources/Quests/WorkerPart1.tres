[resource]
script = ExtResource("1_lk683")
icon = ExtResource("1_c34hh")
quest_name = "О дивный новый мир, часть 1"
character_name = "Сэд Клинтвуд"
any_quest_dependencies = Array[ExtResource("1_lk683")]([ExtResource("3_3ekmd")])
text_greetings = "Здравствуйте. Наконец-то мы с вами смогли лично пообщаться. 

Меня зовут Сэнд Клинтвуд. К вам перевели из отдела мониторинга Кирпично-стальных заводов юга Великой Астурской Империи. Там я руководил цехами и самолично смог достичь немалого увеличения эффективности всего производства. Ныне я буду работать на вас. 

Ммм, по всей видимости, я первый из приглашённых специалистов,так что я напомню вам о постановлениях руководства.

У меня, как и у других приглашённых к вам, будут указы или просьбы. Отличие в том, что первое - это утверждённые верхушкой планы, которые получили все нужные печати, а второе - это в основном личные предложения и обращения. По себе скажу, что я не фанат личных просьб. От меня по большей степени вы будете получать только указы.

Давайте перейдём к делу. Сейчас вы только начинаете развивать свой город. Исходя из этого, в начале вам нужно наладить бесперебойное производство ресурсов. Для этого я предоставляю вам одобренный «План Первичной Застройки». Если кратко, то вам нужно построить шесть районов второго тира. Как только план будет исполнен, позвоните мне вновь."
answer_agree = "Берусь за дело (Начать квест)
"
answer_wait = "Вернусь к этому вопросу позже"
text_progress = "Здравствуйте, напоминаю вам об указе. Вам нужно  построить шесть районов второго тира"
text_finish = "Здравствуйте. Я видел отчёты. Всё идёт неплохо. Покойный Роберт Гийом явно на нашей стороне. Позвоните мне ещё раз чуть позже, у меня есть идея, как мы можем значительно ускорить ваше производство."
reward_res_count = 1000
sec_reward_res_type = 2
sec_reward_res_count = 30
