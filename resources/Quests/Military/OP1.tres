building_type = Array[ExtResource("2_sw2y8")]([ExtResource("3_nxjy4")])
text_greetings = "Приём, на линии сержант-майор Вайс. С этих пор я буду отвечать за работу всех военных структур на территории вашего города. Приятно познакомиться.  Также отныне я буду использовать коды шифры, в общении с вами во избежание утечек информации.

В данный промежуток времени наша дислокация почти граничит с объектом [b][color=#FFFF5D][url=Rock]#44566.1[/url][/color][/b], он же центральная фигура в вашей миссии. 
Самое время начать заготавливать оружие и готовиться к исполнению плана [b][color=#FFFF5D][url=Destroy]#Штормовой-Прилив.8[/url][/color][/b]. 
Буду немногословен, [b]постройте[/b] [b][color=#FF59CA]четыре[/color][/b] [b]района[/b] [b][color=#FF59CA]\"Военной мощи\"[/color][/b], и мы с вами в тот же час начнём производство оружия."
answer_agree = "Приём. Я построю"
answer_wait = "Приём. Вернусь к этому вопросу позже."
text_progress = "Приём. [b][color=#FFFF5D][url=NStart]Код #4335[/url][/color][/b]. 
Ожидаю от вас [b]постройки[/b] [b][color=#FF59CA]четырёх[/color][/b] [b]районов[/b] [b][color=#FF59CA]\"Военной Мощи\"[/color][/b]."
text_finish = "Приём. [b][color=#FFFF5D][url=Start]Код #4335 - префикс \"старт\"[/url][/color][/b]. Я зафиксировал ваше строительство и приступаю к производству оружия и снарядов. По мере развития я с вами ещё свяжусь."
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
