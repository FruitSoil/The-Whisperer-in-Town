[resource]
script = ExtResource("1_t4dxp")
icon = ExtResource("7_xh20i")
quest_name = "Взор ястреба, часть 1"
character_name = "Кэтерин Коллар"
worker = 4
any_quest_dependencies = Array[ExtResource("1_t4dxp")]([ExtResource("2_ejdmj")])
quest_after = Array[String](["res://resources/Quests/Agent/EV2.tres"])
complete_condition = 5
int_value = 1
building_type = Array[ExtResource("2_q4i0i")]([ExtResource("4_cxbxp"), ExtResource("5_xjjjk"), ExtResource("6_ec1q3")])
worker_type = ExtResource("8_r1k3i")
open_after_accept = true
text_greetings = "Приветствую вас. Меня зовут [b]Кэтерин К[/b]. С этого момента я отвечаю за сферу безопасности и контроля. До перевода сюда работала в [b]\"Стальном Порту\"[/b], можно сказать, что я обычный представитель рабочего класса, как и все прочие. 

Я имею представление о вашей миссии, в связи с этим хочу сразу приступить к исполнению своего долга. [b][color=#FFFF5D][url=Throw]Направьте [/url][/color][/b] меня в один из [b][color=#FF59CA]районов \"Старых заводов\"[/color][/b]. Я займусь этой отраслью в первую очередь, так как считаю это благоразумным."
answer_agree = "Здравствуйте, я направлю вас туда.
"
answer_wait = "Вернусь к этому вопросу позже."
text_progress = "Ожидаю отправку в один из районов \"Старого завода\"."
text_finish = "Здравствуйте. Пришла к вам с отчётом по проделанной работе. Честно признаться, поначалу ситуация в районах была крайне напряжённой, так что были приняты соответствующие меры. 

Во время работы я выделила три категории нарушителей порядка:

Первые - это мелкие [b][color=#FFFF5D][url=DeboRE]дебоширы[/url][/color][/b]. Они были наказаны стандартным уменьшением количества пайков.

Вторые - это крупные [b][color=#FFFF5D][url=RezeRE]рецидивисты[/url][/color][/b]. Прошлые наказания им не помогли, так что все они были казнены на месте.

Третьими выступали [b]коррупционеры[/b] и гниль общества. К ним мы применили самое жёсткое наказание: вместе с семьями их публично казнили на площади для преподания другим урока.

С вычищением гнили районы стали функционировать лучше и эффективнее. 

Также спешу вам сообщить о возмутительном поведении мистера [b]Сэда[/b]. Во время нашего с ним контакта он вёл странные, лишённые смысла рассуждения и, судя по отчётам, отдавал такие же бессмысленные указания рабочим. Трогать я его пока не стала, так как он находится в вашей личной юрисдикции, но в дальнейшем советую обратить на это внимание."
reward_res_type = 2
reward_res_count = 5
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
