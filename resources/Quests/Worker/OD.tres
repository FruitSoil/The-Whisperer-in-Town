quest_name = "Гнетущая болезнь, часть 1"
is_mandatory = false
character_name = "Сэд Клинтвуд"
worker = 1
any_quest_dependencies = Array[ExtResource("1_etlt5")]([ExtResource("2_etlt5")])
quest_after = Array[String](["res://resources/Quests/Agent/EV1.tres", "res://resources/Quests/Scientist/RD1.tres", "res://resources/Quests/Worker/OD2.tres", "res://resources/Quests/Agent/EV3.tres"])
