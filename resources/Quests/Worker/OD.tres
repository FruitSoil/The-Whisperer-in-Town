int_value = 1
building_type = Array[ExtResource("2_d0yba")]([ExtResource("4_etlt5"), ExtResource("5_d0yba"), ExtResource("6_63vx2")])
worker_type = ExtResource("8_it1oq")
open_after_accept = true
text_greetings = "Здравствуйте, я к вам с просьбой. В последнее время мне не здоровится, в связи с этим моя продуктивность значительно упала. Я же хочу попросить вас, чтобы вы [b][color=#FFFF5D][url=Throw]отправили[/url][/color][/b] меня обратно в [b][color=#FF59CA]районы \"старых заводов\"[/color][/b]. В какой-то степени я даже соскучился по тем кирпичным стенам, да и не так ветренно там, по сравнению со Снегонаукой. 

Когда вы меня передислоцируете, как только смогу я вернусь к своим обязанностям."
answer_agree = "Я готов отправить тебя обратно в район старых заводов. "
answer_wait = "Вернусь к этому позже."
answer_reject = "Я не буду этого делать"
text_reject = "Принимаю вас отказ. Простите, что принёс лишние неудобства."
text_progress = "Ожидаю свою [b][color=#FFFF5D][url=Throw]отправку[/url][/color][/b] в один из [b][color=#FF59CA]районов \"Старых заводов\"[/color][/b]. Не терпиться вновь увидеть их."
text_finish = "Благодарю вас, за то что позволили эту глупость. Я всеми силами постараюсь вернуться в нужное русло, как можно быстрее. Не беспокойтесь, много времени это не займёт."
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
