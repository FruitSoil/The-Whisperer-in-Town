[resource]
script = ExtResource("1_yyjcp")
icon = ExtResource("8_7du74")
quest_name = "Тьма над бездною"
is_mandatory = false
character_name = "Сэд Клинтвуд"
worker = 1
done_quest_dependencies = Array[ExtResource("1_yyjcp")]([ExtResource("3_i17gx")])
quest_after = Array[String](["res://resources/Quests/Agent/WAR1.tres"])
text_greetings = "Ты, грёбаный кусок дерьма, ты предпочёл это, помощи нам! Чёртова подстилка [b][color=#FFFF5D][url=EmpG]Империи[/url][/color][/b], империи безнадёжных ублюдков. 
Грёбаный чинуша, что решил, будто именно он решает судьбу человечества. 

[b][color=#CE0000]Мы обречены, ты обречён! [/color][/b]

Я обречён. Я уже знаю, что со мной будет.  Они оставят меня живым как свидетеля. Но это не милость. 
Они лишат меня всего лишнего, я буду лишь переносной машиной без воли, без ног и рук. И всё ЭТО - твоя вина! ТВОЯ ВИНА.

[b][color=#CE0000]Ты убил его, УБИЛ, ТЕПЕРЬ ЕГО НЕТ.[/color][/b]
Ты бросил меня на смерть, оставил, пряча свои глаза.

Искупление было так близко, а теперь один из светочей пал. 
Я ненавижу тебя, я презираю тебя всей душой!

Но.... у тебя будет последний шанс, ты сможешь сделать финальный выбор. Хоть его и меня уже не будет, но ты сможешь дать человечеству шанс на развитие! На разрушение оков и инстинктов! Прошу. Это моя последняя просьба.

[shake rate=20.0 level=5 connected=1][b]Прощай, больше мы не увидимся.[/b][/shake]"
answer_agree = "(Дальше)"
answer_reject = "Вынужден отказать."
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
