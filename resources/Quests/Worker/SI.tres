worker_type = ExtResource("8_ksxhw")
open_after_accept = true
text_greetings = "Здравствуйте, как я вижу внедрение новой технологии идёт полным ходом. Отправка нам [b]Говарда[/b] было довольно мудрым решением [b][color=#FFFF5D][url=Boss]руководства[/url][/color][/b]. 

Ну что-ж, перейдём пожалуй к делу. Интеграция в наш город [b]электроэнергетики[/b] продвигается довольно гладко. Но я бы также хотел самолично отправится в новые районы, с целью большего понимания их устроства. Таким образом я смогу сформулировать способы по улучшению их инфоструктуры и соответсвенно продуктивности. В связи с этим был подписан [b][color=#FFFF5D][url=Must]указ[/url][/color][/b], по которому вы должны [b][color=#FFFF5D][url=Throw]отправить[/url][/color][/b] меня в любой [b][color=#FF59CA]район \"Снегонауки\"[/color][/b]. Этого мне хватит."
answer_agree = "Я отправлю тебя, Сэд (Начать квест)
"
answer_wait = "Займусь этим чуть позже"
text_progress = "Здравствуйте! Напоминаю вам об [b][color=#FFFF5D][url=Must]указе[/url][/color][/b]. Вам нужно просто [b][color=#FFFF5D][url=Throw]отправить[/url][/color][/b] меня в любой из [b][color=#FF59CA]районов \"Снегонауки\"[/color][/b]"
text_finish = "Здравствуйте, отчитываюсь вам об плодотворности прибывания в районе [b][color={#FFFF5D}][url=SnowSc]\"Снегонауки\"[/url][/color][/b]. Совсем недавно мне довелось говорить с [b]Говордом[/b]. В том числе мы обсудили и свежие проблемы при состовлении чертежей. Но спешу вас заверить, общими усилями и рассуждениями мы явно сдвинулись с мёртвой точки. Впереди ещё множество работы, но я не вижу причин сомневаться в успешности данной авантюры. "
reward_res_type = 1
reward_res_count = 500
sec_reward_res_type = 2
sec_reward_res_count = 14
