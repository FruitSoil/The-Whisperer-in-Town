[resource]
script = ExtResource("1_d7o8w")
icon = ExtResource("7_3ug0b")
quest_name = "Гнетущая болезнь, часть 2"
is_mandatory = false
character_name = "Сэд Клинтвуд"
worker = 1
done_quest_dependencies = Array[ExtResource("1_d7o8w")]([ExtResource("6_d7o8w"), ExtResource("7_30j85")])
quest_after = Array[String](["res://resources/Quests/Scientist/RD1.tres", "res://resources/Quests/Worker/OD3.tres", "res://resources/Quests/Agent/EV3.tres"])
reject_other_quest_skip = Array[String](["res://resources/Quests/Worker/OD3.tres"])
complete_condition = 5
int_value = 1
building_type = Array[ExtResource("3_m2tlg")]([ExtResource("4_d7o8w"), ExtResource("5_30j85"), ExtResource("6_m2tlg")])
worker_type = ExtResource("8_fe5il")
open_after_accept = true
text_greetings = "Здравствуйте. Давненько я с вами не связывался. Прошу меня простить, мне всё это время нездоровилось. Но теперь я, как будто, наконец проснулся ото сна и вновь готов вам помогать, как и раньше.
Но перед началом я бы хотел попросить вас об одной [b][color=#FFFF5D][url=Should]услуге[/url][/color][/b]. Недавно, впервые за жизнь, воочию я услышал [b][color=#FFFF5D][url=Radio]радио[/url][/color][/b]! До этого я только читал о нём как об легенде, утраченной в прошлом, а сейчас оно вновь вещает! Я прошу вас [b][color=#FFFF5D][url=Throw]отправить меня[/url][/color][/b] в один из [b][color=#FF59CA]районов \"Высоких Технологий\"[/color][/b], к источнику радиовещания. Я думаю, в порыве этого вдохновения я смогу сослужить вам службу и помочь вам с городом, как и ранее."
answer_agree = "Хорошо я отправлю тебя"
answer_wait = "Вернусь к этому вопросу позже."
answer_reject = "Вынужден отказать."
text_reject = "Вы разрушаете мне сердце. Что в моих словах было не так, чем помешает моё прибывания там! Это бы пошло вам на пользу.... ладно, я услышал ваш приказ. Я возращаюсь к привычному роду деятельности."
text_progress = "Жду свою [b][color=#FFFF5D][url=Throw]отправку[/url][/color][/b] в один из [b][color=#FF59CA]районов \"Высоких Технологий\"[/color][/b]"
text_finish = "Уведомляю, что отправка увенчалась успехом! Я уже немного освоился в новом [b]районе[/b], в скором времене буду беседовать с [b]Артом Беллом[/b]. Держу вас в курсе."
reward_res_type = 2
reward_res_count = 15
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
