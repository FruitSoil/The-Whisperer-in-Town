quest_name = "Гнетущая болезнь, часть 3"
is_mandatory = false
character_name = "Сэд Клинтвуд"
worker = 1
done_quest_dependencies = Array[ExtResource("1_vmh7n")]([ExtResource("7_phxe8")])
any_quest_dependencies = Array[ExtResource("1_vmh7n")]([ExtResource("2_vmh7n")])
quest_after = Array[String](["res://resources/Quests/Scientist/RD2.tres", "res://resources/Quests/Agent/EV3.tres"])
complete_condition = 5
int_value = 1
building_type = Array[ExtResource("2_phxe8")]([ExtResource("3_etgkr"), ExtResource("4_abn5u"), ExtResource("5_uvsd7")])
worker_type = ExtResource("9_qdft1")
open_after_accept = true
text_greetings = "Здравствуйте! Я к вам с хорошими новостями, на днях мне выпал шанс поболтать с самим [b]Артом Беллом[/b]! Наш диалог сложно описать словами, я многое переомыслил.  Вы пока не понимаете, но мы на пороге нового [b]рассвета[/b] человечества! 

Он грядёт сюда, и с ним мы обретём новую форму существования. Я прошу вас о маленькой услуге, помогите нам расширить нити влияния! назначьте ещё [b][color=#FF59CA]четырех[/color][/b] [b]работников[/b] на [b]районы[/b] [b][color=#FF59CA]\"Высоких Технологий\"[/color][/b], пусть радиовечер  будет вечным."
answer_agree = "Я сделаю это."
answer_wait = "Вернусь к этому вопросу позже."
answer_reject = "Я отказываюсь"
text_reject = "Вы мешаете нам в такой момент? Замедляете нам просвещение людей, вы буквально уничтожаете мечты из-за своей гордости. Ведь так? 

Но ладно, вы и впрямь многое для нас сделали. В иной раз вы сможете нам помочь, в тот момент когда это будет нужно."
text_progress = "Я с нетерпением жду момента - расширения нашего радиовлияния. Вам нужно назначить ещё [b]4[/b] работника на районы!"
text_finish = "Благодарю вас за помощь. Вы вносите незаменимый вклад в наше дело. В ближайшем будущем, именно вы станете тем, кто сможет принести [b]рассвет[/b] в наш умирающий мир. Человечество, с первобытных времён, не могло эволюционировать дальше. Пока неотёсанные динозавры превращались в изящных птиц, мы лишь лицезрели это. Теперь всё же будет иначе."
reward_res_type = 2
reward_res_count = 15
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
