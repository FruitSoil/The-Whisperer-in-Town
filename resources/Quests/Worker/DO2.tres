[resource]
script = ExtResource("1_4jk6u")
icon = ExtResource("4_p6b6w")
quest_name = "Рассвет над бездною"
is_mandatory = false
character_name = "Сэд Клинтвуд"
worker = 1
done_quest_dependencies = Array[ExtResource("1_4jk6u")]([ExtResource("3_4jk6u")])
text_greetings = "[b]Рассвет[/b] придёт, я верю в это. Символ изменений человеческой расы и надежда, откраплённая медью. Ветер, что доносит далёкие возгласы триумфа. [b]Великий[/b], что придёт сюда, и мы же станем частью его плана. Камень - словно зеркало в иное, радио - будто дверь. [shake rate=20.0 level=5 connected=1][b]Песни далёких миров расскажут нам о давних временах[/b][/shake]. 

Человечество на пороге своего главного дара, ты поможешь нам его добыть. Не пади ты в лапы врага своего, не дай склонить себя в столь важный час. Многие историки, словно летописцы времён, заложат фундамент для новой вехи истории. 

Величайший из веков, слияние душ и мнений. [b]Архичеловек[/b], его финальная форма. С помощью [b]блуждающего рассвета[/b] мы сможем вознестись, сможем достичь недостижимого. Мы больше не будем смотреть на звёзды, мы будем их чувствовать. Нутром и телом.

Невежество сойдёт на нет, и мы сможем любоваться празднеством и [b]рассветом[/b] нашего мира."
answer_agree = "(Дальше)"
answer_reject = "Вынужден отказать."
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
