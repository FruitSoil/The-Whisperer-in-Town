building_type = Array[ExtResource("3_gjubd")]([ExtResource("4_vpsey")])
text_greetings = "Здравствуйте. Наконец-то мы с вами смогли лично пообщаться. 

Меня зовут [b]Сэнд Клинтвуд[/b]. К вам перевели из отдела мониторинга Кирпично-стальных заводов юга [b][color=#FFFF5D][url=EmpG]Великой Астурской Империи[/url][/color][/b]. Там я руководил цехами и самолично смог достичь немалого увеличения эффективности всего производства. Ныне я буду работать на вас. 

Ммм, по всей видимости, я первый из приглашённых специалистов,так что я напомню вам о постановлениях [b][color=#FFFF5D][url=Boss]руководства[/url][/color][/b].

От меня, как и от у других приглашённых к вам, будут передаваться [b][color=#FFFF5D][url=Must]указы[/url][/color][/b] или [b][color=#FFFF5D][url=Should]просьбы[/url][/color][/b]. Отличие в том, что первое - это утверждённые верхушкой планы, которые получили все нужные печати, а второе - это в основном личные предложения и обращения. По себе скажу, что я не фанат личных просьб. От меня по большей степени вы будете получать только подписанные [b][color=#FFFF5D][url=Must]указы[/url][/color][/b].

Что-ж, давайте перейдём к делу. Сейчас вы только начинаете развивать свой город. Исходя из этого, в начале вам нужно наладить бесперебойное производство ресурсов. Для этого я предоставляю вам одобренный «План Первичной Застройки». Если кратко, то вам нужно [b]построить[/b] [b][color=#FF59CA]шесть[/color][/b] [b]районов[/b] [b][color=#FF59CA]II[/color][/b] [b]тира[/b]. Как только план будет исполнен, позвоните мне вновь."
answer_agree = "Берусь за дело (Начать квест)"
answer_wait = "Вернусь к этому вопросу позже"
text_progress = "Здравствуйте, напоминаю вам об переданном мной [b][color=#FFFF5D][url=Must]указе[/url][/color][/b]. Вам нужно [b]построить[/b] [b][color=#FF59CA]шесть[/color][/b] [b]районов[/b] [b][color=#FF59CA]II[/color][/b] [b]тира[/b]"
text_finish = "Здравствуйте. Я видел отчёты. Всё идёт неплохо. Покойный [b][color=#FFFF5D][url=Robert]Роберт Гийом[/url][/color][/b] явно на нашей стороне. Позвоните мне ещё раз чуть позже, у меня есть идея, как мы можем значительно ускорить ваше производство."
reward_res_type = 2
reward_res_count = 7
sec_reward_res_type = 2
