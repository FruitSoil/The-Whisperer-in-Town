[resource]
script = ExtResource("1_xmfxj")
icon = ExtResource("5_le1b5")
quest_name = "О дивный новый мир, часть 1"
character_name = "Сэд Клинтвуд"
worker = 1
any_quest_dependencies = Array[ExtResource("1_xmfxj")]([ExtResource("2_w70nr")])
