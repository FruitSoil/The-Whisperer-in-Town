[resource]
script = ExtResource("1_e42nx")
icon = ExtResource("3_ldhyl")
quest_name = "О дивный новый мир, часть 2"
character_name = "Сэд Клинтвуд"
worker = 1
done_quest_dependencies = Array[ExtResource("1_e42nx")]([ExtResource("2_e42nx")])
quest_after = Array[String](["res://resources/Quests/Scientist/EE1.tres"])
complete_condition = 3
int_value = 9
text_greetings = "Здравствуйте. Я тут перебирал старые документы, и это натолкнуло меня на некоторые мысли. Я знаю, каким образом мы сможем добиться значительного скачка в [b]производстве[/b] и, плюсом к этому, внедрить недавние инновации в сфере [b]электроэнергетики[/b]. Всё это мы с вами будем реализовывать в новом [b]III тире районов[/b].

Но скажу сразу: исходя из моего опыта, подобная модернизация производства ведёт к ухудшению жилищных условий. Боюсь, резкое внедрение подобного может пагубно повлиять на дальнейший рост города. Так что я предлагаю для начала повысить [b][color=#FFFF5D][url=Loyal]лояльность[/url][/color][/b] рабочих к вам.

[b][color=#FFFF5D][url=Must]Указ[/url][/color][/b]: [b]наймите[/b] на районы [b][color=#FF59CA]девять[/color][/b] [b]руководителей[/b]. С тщательным надзором и дисциплиной, люди смогут менее болезненно переносить ту тяжёлую работу, которая им предстоит. Как только вы всех наймёте, сообщите мне."
answer_agree = "Я готов назначить больше руководителей (Начать квест)
"
answer_wait = "Вернусь к этому вопросу позже."
text_progress = "Здравствуйте, напоминаю об [b][color=#FFFF5D][url=Must]указе[/url][/color][/b]. Вам нужно [b]нанять[/b] [b][color=#FF59CA]девять[/color][/b] [b]руководителей[/b] на районы."
text_finish = "Всё прошло как надо, поздравляю вас с этим! Строгий надзор и дисциплина помогли впрямить мозг людям. В связи с этим мы смогли позволить себе более тяжёлое и трудоёмкое производство. Теперь вы можете смело строить район [b]III тира[/b] под названием: [b][color=#FFFF5D][url=Z1D3]\"Конвейерный сектор\"[/url][/color][/b]. С его помощью вы в скором времени сможете начать постигать [b]электроэнергетику[/b]."
reward_res_count = 20
building_unlock_res = ExtResource("2_of308")
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
