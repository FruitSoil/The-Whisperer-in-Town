worker_type = ExtResource("8_nxt3c")
text_greetings = "Добрый вечер! В эфире наш с вами не непроизведённый план по модернизации вашего города. Для вас буду вещать я - [b]Арт Белл[/b]. 

Подводя итоги первого [b]строительства[/b], нельзя не отметить феноменальные результаты! Когда-то давно радио уничтожило расстояние и соединило невидимой, но крепкой связью все корабли и города Земли! [b]Назначьте[/b] [b][color=#FF59CA]семь[/color][/b] [b]руководителей[/b] в новые [b]районы[/b] [b][color=#FF59CA]\"Высоких Технологий\"[/color][/b]! Пусть радиовещание распустит свои блаженные нити и коснётся сердец людей. Дадим им шанс слицезреть новый [b]рассвет[/b]!"
answer_agree = "Хорошо я займусь этим."
answer_wait = "Вернусь к этому вопросу позже."
text_progress = "Ожидаю момента, когда смогу гордо сказать: \"львиная доля нашего плана выполнена успешно\". Вам нужно [b]назначить[/b] [b][color=#FF59CA]семь[/color][/b] [b]руководителей[/b] в [b]районы[/b] [b][color=#FF59CA]\"Высоких Технологий\"[/color][/b]"
text_finish = "Эфир пополнился активными слушателями! с тобой мы постигаем новые грани вещания!

Хмм, я думаю, у тебя уже появился вопрос: в чём же такая особенность [b][color=#FFFF5D][url=Radio]радио[/url][/color][/b]?
Что ж, если проще, то [b][color=#FFFF5D][url=Radio]радио[/url][/color][/b] - это путь к цветению души, к [b]просветлению[/b] и [b]просвещению[/b]. Это одновременно и символ, и ключ. 

[b][color=#FFFF5D][url=AgeOf]В нынешнюю эпоху[/url][/color][/b] люди позабыли о нём, оно  затерялось во множестве файлов и папок. Но я помогу тебе возродить [b]рассвет[/b]. Мы сможем стать лучшими версиями себя. 

Подумайте обо всём этом на досуге."
reward_res_type = 3
reward_res_count = 1000
