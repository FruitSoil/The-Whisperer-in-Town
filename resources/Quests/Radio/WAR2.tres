quest_name = "Лживый прогресс"
character_name = "Арт Белл"
worker = 3
complete_condition = 6
int_value = 4
text_greetings = "Добрый вечер! Вскоре [b]рассвет[/b] наконец покажется из-за горизонта! Вместе с вами мы проделали долгий путь, теперь же он подходит к долгожданному концу. 

Но пока [b]Нъхорфаад[/b] не взошёл в наш бренный мир, о скрытности нам не стоит забывать. Мы с [b]Сэдом[/b] всё ещё активно делаем вид, что мы имперские псы. ИМ не к чему знать всю правду до начала нашего [b]рассвета[/b]!

[b]Откройте[/b] [b][color=#FF59CA]IV[/color][/b] [b]зону[/b] [b][color=#FF59CA]\"Военная мощь\"[/color][/b]. Символ отторжения и [b]лжеимперии[/b]. Но её оружие пригодится нашей пастве в предстоящей борьбе за истину."
answer_agree = "Я сделаю это."
answer_wait = "Вернусь к этому вопросу позже."
text_progress = "Наша паства ждёт твой триумф, [b]открой[/b] [b][color=#FF59CA]IV[/color][/b] [b]зону[/b] [b][color=#FF59CA]\"Военная мощь\"[/color][/b]"
text_finish = "Час настал, ОН близко!"
reward_res_type = 4
reward_res_count = 200
