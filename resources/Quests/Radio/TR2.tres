[resource]
script = ExtResource("1_3xues")
icon = ExtResource("5_w37t5")
quest_name = "Сколько стоит правда?"
character_name = "Арт Белл"
worker = 3
quest_after = Array[String](["res://resources/Quests/Worker/DO2.tres"])
text_greetings = "АХХААХХАХ, [b]ИМПЕРКА[/b] ПОПАЛА В НАШИ СЕТИ И НЕ СМОГЛА ИЗБЕЖАТЬ СВОЕГО КОНЦА

Благодаря тебе мы сможем достичь просвещения! [b]Кэтерин Коллар[/b] и его команда теперь мертвы. Никто не сможет нам препятствовать. 

ВЕЛИКИЙ ДРЕВНИЙ СКОРО ПОСЕТИТ НАШ МИР, ЧЕЛОВЕЧЕСТВО РАСЦВЕТЁТ! МЫ СТАНЕМ ЛУЧШИМИ ВЕРСИЯМИ СЕБЯ, БЕЗ ПОРОКОВ И ЮРОДИВОСТИ.

Также спешу сообщить о том, что мы значительно преуспеваем в обмане неверующих. Сэд сейчас активно подделывает отчёты TrES, они не скоро заметят подмену. Он же нашёл кое-что интересное в документах Кэтерин - чертежи нового района. 

Нам он очень пригодится. Ну же, теперь ты можешь строить [b][color=#FFFF5D][url=Z3D3]\"Электросхемный квартал\"[/url][/color][/b] [b]III[/b] и совершенный [b]тир  \"Высоких Технологий\"[/b], он же позволит создавать оружия. Пока наша паства не имеет доступа к полномасштабным заводам, это своего рода её лучшее искуплением своих грехов."
answer_agree = "(Дальше)"
