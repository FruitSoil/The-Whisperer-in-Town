text_greetings = "[shake rate=20.0 level=5 connected=1][b]ПРОСВЕЩЕНИЕ, ВОТ ЧТО ПО-НАСТОЯЩЕМУ ВАЖНО![/b][/shake]
Люди всегда прятались за конструкциями из лжи, но теперь всё иначе. Ты же и сам ощущаешь этот ветер перемен? Так не дай нам пасть! 

За нами, вгрызаясь, охотится [b][color=#FFFF5D][url=TrES]Имперская псина[/url][/color][/b], садистка и убийца. Рассвет что служит нам надеждой, для неё лишь пустой звук. 
[shake rate=20.0 level=5 connected=1][b]ЛЖЕИМПЕРИЯ, ЧТО СТОИТ НА ГОРЕ ТРУПОВ, ДОЛЖНА ПАСТЬ![/b][/shake] [b]Блуждающий рассвет[/b] грядёт! Он спасёт человечество, даст шанс на эволюцию. Мы сможем победить голод, бедность, пороки. ОН сделает нас великими, мы станем подобны ему.

[b][color=#FFFF5D][url=TrES]Имперская псина[/url][/color][/b], хоть и умна, но не лишена бед людских. Мы подготовили для неё удобную наживку, что погубит её навсегда. Позволь человечеству вновь воссиять!"
answer_agree = "Я не буду ей ничего говорить (Выбрать сторону Арта)"
answer_wait = "Я сообщу ей о засаде (Выбрать сторону Кэтерин)"
