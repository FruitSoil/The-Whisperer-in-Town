open_after_accept = true
text_greetings = "Здравствуйте, как я вижу внедрение новой технологии идёт полным ходом. Отправка нам Говарда было довольно мудрым решением руководства. 

Ну что-ж, перейдём пожалуй к делу. Интеграция в наш город электроэнергетики продвигается довольно гладко. Но я бы также хотел самолично отправится в новые районы, с целью большего понимания их устроства. Таким образом я смогу сформулировать способы по улучшению их инфоструктуры и соответсвенно продуктивности. В связи с этим был подписан указ, по которому вы должны отправить меня в любой район \"\"Снегонауки\"\". Этого мне хватит."
answer_agree = "Я отправлю тебя, Сэд (Начать квест)
"
answer_wait = "Займусь этим чуть позже"
text_progress = "Здравствуйте! Напоминаю вам об указе. Вам нужно просто отправить меня в любой из районов \"Снегонауки\""
text_finish = "Здравствуйте, отчитываюсь вам об плодотворности прибывания в районе \"электронауки\". Совсем недавно мне довелось говорить с Говордом. В том числе мы обсудили и свежие проблемы при состовлении чертежей. Но спешу вас заверить, общими усилями и рассуждениями мы явно сдвинулись с мёртвой точки. Впереди ещё множество работы, но я не вижу причин сомневаться в успешности данной авантюры. "
reward_res_type = 1
reward_res_count = 1000
sec_reward_res_type = 2
sec_reward_res_count = 30
