[resource]
script = ExtResource("1_sbfla")
icon = ExtResource("3_ognjr")
quest_name = "Шёпот по тьме"
character_name = "Джеймс Беккет"
worker = 6
text_greetings = "Приветствую тебя. Я Джеймс Беккет, тотб кто аккуратно вёл тебя к этому моменту. Ныне признанный мёртвым, я стою перед тобой.

Монолит близко, твой звёздный час пробил. Весь путь, что ты прошёл, вёл тебя именно к этому моменту. 

[b]Тебе нужно принять решение: [/b]
Если ты поддерживаешь жестокую, закостенелую [b][color=#FFFF5D][url=EmpG]Империю[/url][/color][/b], то смело строй [b][color=#FFFF5D][url=EmPower]\"Астурскую мощь\"[/url][/color][/b].
Если ты поддерживаешь тошнотворный, пугающий [b][color=#FFFF5D][url=Cuelt]Культ[/url][/color][/b], то с такой же смелостью строй [b][color=#FFFF5D][url=CuPower]\"Нъхорфаадскую силу\"[/url][/color][/b].

Время закончить этот спектакль. Я же с упоением буду смотреть за твоим падением."
answer_agree = "Начать финальный Акт"
building_unlock_res = ExtResource("3_7y21w")
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
