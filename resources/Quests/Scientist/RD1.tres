open_after_accept = true
text_greetings = "Приветствую.  До меня дошли известия о странном [b]\"радиовещании\"[/b] из [b]районов \"Высоких Технологий\"[/b]. Лично я убеждён, что оно как-то связано с [b]инцидентами[/b] в [b]III[/b] тире - [b]\"Снегонауки\"[/b], хотя бы косвенно. Думаю так, потому что вновь стал получать те же раппорты о странных снах, переменах в настроении и о [b]нечеловеческих песнях[/b], теперь якобы исходящих из выключенного [b]радио[/b] в глубокой ночи.

Я прошу вас [b][color=#FFFF5D][url=Should]разрешить[/url][/color][/b] и [b][color=#FFFF5D][url=Throw]отправить[/url][/color][/b] меня в любой из [b][color=#FF59CA]районов \"Высоких Технологий\"[/color][/b], чтобы расследовать это дело. У меня есть смутное мнение, что это нечто [b]большее[/b], чем простая случайность или неисправность оборудования. За этим явно стоят люди, не один и не два. "
answer_agree = "Я разрешаю начать расследования, я отправлю тебя в нужное место."
answer_wait = "Вернусь к этому вопросу позже."
answer_reject = "Я отказываюсь."
text_reject = "Принимаю ваш скептицизм, не буду мешать."
text_progress = "Жду [b][color=#FFFF5D][url=Throw]отправки[/url][/color][/b] меня в любой из в [b][color=#FF59CA]районов \"Высоких технологий\"[/color][/b], там я начну своё расследование. "
text_finish = "Приветствую. Уведомляю вас о том, что я передислоцировался в нужный [b]район[/b] и уже начал своё расследование. С первого взгляда тяжело что-то сказать, исходя из рапортов и документов - радиостанция в полном порядке и не должна никак сбоить. Но тут явно нужно копать глубже. Мне также довелось беседовать с [b]Артом Беллом[/b]. Я могу описать его как довольно харизматичного и скрытного человека. Очень тяжело выбить из него хотя бы дольку информации.

Пожалуй, на этом пока всё, я продолжу своё расследование. 

Точно! Есть ещё кое-что, парочка человек упомянули некий [b]рассвет[/b] в странном для него контексте. Сильных подробностей я не выяснил, но, может, это имеет какую-то связь. 

В общем, я продолжу расследование, здесь явно что-то не так, держусь на связи."
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
