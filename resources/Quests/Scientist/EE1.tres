[resource]
script = ExtResource("1_hn7a0")
icon = ExtResource("4_8yjxd")
quest_name = "Эра электротехники, часть 1"
character_name = "Говард Ист"
worker = 2
done_quest_dependencies = Array[ExtResource("1_hn7a0")]([ExtResource("3_on3y1"), ExtResource("4_on3y1")])
