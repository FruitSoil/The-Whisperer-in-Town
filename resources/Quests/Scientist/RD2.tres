[resource]
script = ExtResource("1_w8u54")
icon = ExtResource("9_xttjf")
quest_name = "Настоящий детектив, часть 2"
is_mandatory = false
character_name = "Говард Ист"
worker = 2
done_quest_dependencies = Array[ExtResource("1_w8u54")]([ExtResource("7_b8wpc"), ExtResource("8_w8u54")])
any_quest_dependencies = Array[ExtResource("1_w8u54")]([ExtResource("2_txoi0"), ExtResource("3_w8u54"), ExtResource("4_txoi0")])
quest_after = Array[String](["res://resources/Quests/Agent/EV3.tres"])
complete_condition = 2
int_value = 5
building_type = Array[ExtResource("3_pbtht")]([ExtResource("5_5nbak")])
text_greetings = "Приветствую, моё расследование продолжается. Чем больше информации я нахожу, тем более ужасающей становится картина. Подпольные ритуалы, жертвы и безумие, а ведь это далеко не всё!

С уверенностью могу сказать, что это культ некого \"рассвета\". В настоящее время я пытаюсь выяснить их мотивы, что они вкладывают в слово \"рассвет\". 
Пока что безуспешно. Но у меня есть идея, как можно ненадолго отвлечь их. [b]Постройте[/b] [b][color=#FF59CA]пять[/color][/b] [b]района[/b] [b][color=#FF59CA]II[/color][/b] [b]тира[/b] [b][color=#FF59CA]\"Высоких Технологий\"[/color][/b]. Это выиграет мне время, и я смогу незаметно добраться до истины."
answer_agree = "Я сделаю это"
answer_wait = "Вернусь к этому вопросу позже."
answer_reject = "Отказано."
text_reject = "Вы, сделали что? Я... в прочем не важно. Дальше я продолжу сам."
text_progress = "Жду когда вы отвлечёте их, [b]построив[/b] [b][color=#FF59CA]пять[/color][/b] [b]районов[/b] [b][color=#FF59CA]II[/color][/b] [b]тира[/b] [b][color=#FF59CA]\"Высоких Технологий\"[/color][/b]"
text_finish = "Я смог раскопать правду, пробравшись к ним в логово. 
Сотни заметок и дневников я прочитал,  даже не знаю с чего начать. 

Я опишу вам лишь общую картину, вы не готовы к всей истине сразу. Поверьте тому, чей рассудок ныне плавает.

Культ [b]\"Рассвета\"[/b] покланяется [b]\"древнему\"[/b], не с нашего слоя эфира - [b]Нъхорфаад[/b] его называют. Но это лишь условное обозначение, попытка передать клокочущие, бурлящие звуки во что-то читаемое.  

Также имя ему: [b]\"блуждающий рассвет\"[/b]. По писаниям, с его приходом человечеству настанет конец. Это создание располагается в своём закрытом логове где-то далеко за познаваемым, мы лишь пешки в его замыслах. Величие и эволюция человечества, по подобию [b]Нъхорфаада[/b] и его фантазий. 
Образ человека исказится, этого и хотят культисты! Называя это просвещением, но они не понимают, что это реально значит. Они верят его сладкому голосу, что подобен вьюге.

У меня мало времени. Прошу, не позвольте фантасмогории рассвета заполнить наш мир. Я же спрячусь, за последнее время я привлёк слишком много внимания. Надеюсь, мы сможем связаться вновь."
metadata/_custom_type_script = "uid://4xn2kpvnsmr8"
