[node name="Endings" type="Node2D" unique_id=391644759]
script = ExtResource("1_j65i4")
imperial_ending_text = "После уничтожения последнего монолита все скрытые ячейки культа, что прятались десятилетиями, восстали. 
Мир вновь погрузился в вечную войну. 

Интересно, какой исход будет в этот раз?"
cultistic_ending_text = "После ритуала Рассвета мир наконец преобразился. Человеческие оковы пали, открыв долгожданную эволюцию.

Интересно, осталось ли человечность в этой буре искажений?"

