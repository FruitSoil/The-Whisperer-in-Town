[sub_resource type="GDScript" id="GDScript_xegqy"]
resource_name = "TutorSlider"
script/source = "extends Control

@onready var rich_text_label: RichTextLabel = $\"../../../../../Dialogue/Panel/MC/RichTextLabel\"
var scroll_line: int

func _on_gui_input(event: InputEvent) -> void:
	if event.is_action_released(\"zoom+\"):
		scroll_line = clamp(scroll_line-1, 0,rich_text_label.get_line_count())
		rich_text_label.scroll_to_line(scroll_line)
	if event.is_action_released(\"zoom-\"):
		scroll_line = clamp(scroll_line+1, 0,rich_text_label.get_line_count())
		rich_text_label.scroll_to_line(scroll_line)
"

