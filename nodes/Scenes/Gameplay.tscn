[sub_resource type="GDScript" id="GDScript_tt4qn"]
resource_name = "IconPanelLogic"
script/source = "extends Control

@onready var start_imper_icon: TextureRect = $StartImperIcon
@onready var imperial_icon: TextureRect = $Imperial_icon
@onready var cultistic_icon: TextureRect = $Cultistic_icon

@onready var final_mode: Control = $Final_mode
@onready var panel_middle_thing: ColorRect = $PanelMiddleThing

@onready var imperial_progress: ProgressBar = $Final_mode/ImperialProgress
@onready var cultistic_progress: ProgressBar = $Final_mode/CultisticProgress

func _ready() -> void:
	Global.change_ending_progress.connect(update_progress)

func verdict_change_side(is_art: bool):
	start_imper_icon.hide()
	if is_art:
		cultistic_icon.show()
	else:
		imperial_icon.show()

func final_stage_show():
	imperial_icon.hide()
	cultistic_icon.hide()
	panel_middle_thing.show()
	final_mode.show()

func update_progress():
	imperial_progress.value = Global.imperial_might
	cultistic_progress.value = Global.cultist_might
	check_ending()

func check_ending():
	if imperial_progress.value >= 100:
		pass
	if cultistic_progress.value >= 100:
		pass
"

