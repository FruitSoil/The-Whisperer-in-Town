[sub_resource type="GDScript" id="GDScript_hwrqn"]
resource_name = "Strech_Tween"
script/source = "extends Node

@onready var build: Button = $\"../Buildings\"
@onready var zones: Button = $\"../Zones\"

func _ready() -> void:
	build.pressed.connect(press.bind(build))
	zones.pressed.connect(press.bind(zones))

func press(node: Button):
	var time: float = 0.3
	var yellow = Color(\"fffc5eff\")
	var twsr = create_tween().set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_CUBIC).set_parallel(true)
	if node == build:
		twsr.tween_property(build, \"size_flags_stretch_ratio\", 1.5, time)
		twsr.tween_property(build, \"self_modulate\", yellow, time)
		twsr.tween_property(zones, \"size_flags_stretch_ratio\", 1, time)
		twsr.tween_property(zones, \"self_modulate\", Color.WHITE, time)
	else:
		twsr.tween_property(build, \"size_flags_stretch_ratio\", 1, time)
		twsr.tween_property(build, \"self_modulate\", Color.WHITE, time)
		twsr.tween_property(zones, \"size_flags_stretch_ratio\", 1.5, time)
		twsr.tween_property(zones, \"self_modulate\", yellow, time)
		
"

