[sub_resource type="GDScript" id="GDScript_hn85b"]
resource_name = "state_feedback"
script/source = "extends TextureRect


@export_color_no_alpha var build_color := Color(0.067, 0.112, 0.299, 1.0)
@export_color_no_alpha var build_color_label := Color(0.036, 0.063, 0.187, 1.0)
@export_color_no_alpha var worker_color := Color(0.18, 0.395, 0.132, 1.0)
@export_color_no_alpha var worker_color_label := Color(0.08, 0.203, 0.053, 1.0)
@export_color_no_alpha var demolition_color := Color(0.247, 0.0, 0.0, 1.0)
@export_color_no_alpha var demolition_color_label := Color(0.212, 0.014, 0.024, 1.0)

func change_state(state:int, is_show: bool):
	if is_show:
		match state:
			1:
				$Label.text = \"Режим строительства (ПКМ)\"
				self_modulate = build_color
				$Label.self_modulate = build_color_label
				tween_show_anim()
			2:
				$Label.text = \"Режим назначения (ПКМ)\"
				self_modulate = worker_color
				$Label.self_modulate = worker_color_label
				tween_show_anim()
			3:
				$Label.text = \"Режим сноса (ПКМ)\"
				self_modulate = demolition_color
				$Label.self_modulate = demolition_color_label
				tween_show_anim()

func tween_show_anim():
	var twm = create_tween().set_trans(Tween.TRANS_QUART).set_ease(Tween.EASE_OUT)
	twm.tween_property(self, \"modulate\",Color(1.0, 1.0, 1.0, 1.0), 0.3)

func tween_hide_anim():
	var twm = create_tween().set_trans(Tween.TRANS_QUART).set_ease(Tween.EASE_OUT)
	twm.tween_property(self, \"modulate\",Color(1.0, 1.0, 1.0, 0.0), 0.3)
"

